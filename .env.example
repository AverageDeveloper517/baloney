# Baloney v2 — copy this file to .env and fill in the first two values.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Developer Portal -> your app -> General Information
CLIENT_ID=

# Optional. Set this to a server id to register commands instantly while
# developing. Leave empty to register globally (can take up to an hour).
GUILD_ID=

# Optional. Discord user id allowed to run /debug. Leave empty to disable it.
OWNER_ID=

# Optional. Where the stats file lives. In Docker this is /app/data/stats.json.
# DATA_FILE=data/stats.json
